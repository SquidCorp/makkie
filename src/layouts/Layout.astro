---
interface Props {
	title: string;
	description?: string;
}

const { title, description = "Makkie — Le néerlandais, sans prise de tête. 5 expressions par jour pour parler comme un natif." } = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
		<style is:global>
			:root {
				--color-primary: #E86100;
				--color-primary-dark: #C44E00;
				--color-primary-light: #FFF0E0;
				--color-secondary: #0F0F1B;
				--color-surface: #FFFFFF;
				--color-bg: #FDFBF8;
				--color-bg-warm: #FFF8F0;
				--color-text: #1A1A2E;
				--color-text-secondary: #5A5A72;
				--color-text-muted: #8A8A9E;
				--color-border: #E8E4DE;
				--font-body: 'Inter', system-ui, sans-serif;
				--font-heading: 'Space Grotesk', system-ui, sans-serif;
				--radius: 14px;
				--radius-sm: 8px;
				--shadow-sm: 0 1px 2px rgba(15, 15, 27, 0.05);
				--shadow-md: 0 4px 12px rgba(15, 15, 27, 0.08);
				--shadow-lg: 0 12px 40px rgba(15, 15, 27, 0.12);
				--shadow-primary: 0 8px 24px rgba(232, 97, 0, 0.25);
			}

			*, *::before, *::after {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			html {
				scroll-behavior: smooth;
				font-size: 16px;
			}

			body {
				font-family: var(--font-body);
				color: var(--color-text);
				background: var(--color-bg);
				line-height: 1.6;
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
			}

			img {
				max-width: 100%;
				height: auto;
				display: block;
			}

			a {
				color: inherit;
				text-decoration: none;
			}

			button {
				font-family: inherit;
				cursor: pointer;
				border: none;
				background: none;
			}

			ul, ol {
				list-style: none;
			}
		</style>
	</head>
	<body>
		<slot />
	</body>
</html>
