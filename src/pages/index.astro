---
import Layout from "../layouts/Layout.astro";

const features = [
	{
		icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>`,
		title: "Sens réel",
		desc: "Chaque fiche explique ce que l'expression veut vraiment dire, loin de la traduction littérale."
	},
	{
		icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
		title: "Contexte & registre",
		desc: "Oral, familier, un peu brusque ou critique : chaque fiche précise où et comment l'utiliser."
	},
	{
		icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>`,
		title: "Pièges évités",
		desc: "Chaque fiche signale le piège pour francophones : image trompeuse, faux ami, confusion avec une autre expression."
	},
	{
		icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`,
		title: "Révision par QCM",
		desc: "Une situation en français, quatre options en néerlandais. Ce que tu rates revient en priorité à la session suivante."
	}
];
---

<Layout title="Makkie — Le néerlandais, sans prise de tête">
	<!-- HEADER -->
	<header class="site-header">
		<div class="header-inner">
			<a href="/" class="logo">
				<span class="logo-flag">🇳🇱</span>
				<span class="logo-text">Makkie</span>
			</a>
			<nav class="header-nav">
				<a href="#fonctionnement">Fonctionnement</a>
				<a href="#exemple">Exemple</a>
			</nav>
			<a href="/jeux" class="header-cta">Commencer</a>
		</div>
	</header>

	<!-- HERO -->
	<section class="hero">
		<div class="hero-bg">
			<div class="stripe red"></div>
			<div class="stripe white"></div>
			<div class="stripe blue"></div>
		</div>
		<div class="hero-content">
			<div class="hero-badge">
				<span class="badge-dot"></span>
				5 expressions par jour
			</div>
			<h1 class="hero-title">
				Le néerlandais,<br />
				<span class="accent">sans prise de tête.</span>
			</h1>
			<p class="hero-subtitle">
				Traduire une expression mot à mot ne suffit pas.
				<br />
				<strong>Makkie</strong> t'aide à comprendre le <strong>sens réel</strong> d'une expression néerlandaise, son <strong>contexte d'usage</strong>,
				et à la retrouver au bon moment.
			</p>
			<div class="hero-actions">
				<a href="/jeux" class="btn btn-primary">
					<span>Commencer une session</span>
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
				</a>
				<a href="#fonctionnement" class="btn btn-ghost">Voir comment ça marche</a>
			</div>
			<div class="hero-stats">
				<div class="stat">
					<span class="stat-number">5</span>
					<span class="stat-label">expressions / jour</span>
				</div>
				<div class="stat-divider"></div>
				<div class="stat">
					<span class="stat-number">~5 min</span>
					<span class="stat-label">par session</span>
				</div>
				<div class="stat-divider"></div>
				<div class="stat">
					<span class="stat-number">0</span>
					<span class="stat-label">compte nécessaire</span>
				</div>
			</div>
		</div>
		<div class="hero-scroll">
			<div class="scroll-mouse">
				<div class="scroll-wheel"></div>
			</div>
		</div>
	</section>

	<!-- PROBLEM -->
	<section class="problem-section" id="problem">
		<div class="container">
			<div class="problem-layout">
				<div class="problem-text">
					<span class="section-tag">Le problème</span>
					<h2 class="section-title">
						Connaître les mots,<br />
						mais pas le sens.
					</h2>
					<p class="section-body">
						Une langue ne se résume pas à son vocabulaire. Elle est aussi faite
						d'<strong>expressions</strong>, d'<strong>images</strong> et de
						<strong>références culturelles</strong> qui ne se traduisent pas littéralement.
					</p>
					<div class="problem-points">
						<div class="problem-point">
							<div class="problem-point-icon">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
							</div>
							<p>Les dictionnaires ne donnent pas le vrai sens figuré.</p>
						</div>
						<div class="problem-point">
							<div class="problem-point-icon">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
							</div>
							<p>Les traductions littérales créent des malentendus.</p>
						</div>
						<div class="problem-point">
							<div class="problem-point-icon">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
							</div>
							<p>On manque le contexte culturel dans les apps classiques.</p>
						</div>
					</div>
				</div>
				<div class="problem-card">
					<div class="card-badge">❌ Traduction littérale</div>
					<div class="fake-expression">
						<span class="fake-dutch">Met de deur in huis vallen</span>
						<span class="fake-literal">→ « tomber dans la maison avec la porte »</span>
						<span class="fake-real">✅ En fait : « aller droit au but »</span>
					</div>
					<div class="card-footer">
						Chaque expression est une petite énigme culturelle.
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- HOW IT WORKS / FEATURES -->
	<section class="features-section" id="fonctionnement">
		<div class="container">
			<div class="section-header">
				<span class="section-tag">Fonctionnement</span>
				<h2 class="section-title">Comprendre, retenir,<br />réutiliser.</h2>
				<p class="section-subtitle">
					Chaque expression a sa fiche : sens, contexte, piège.
					Une session = 5 questions, avec feedback juste ou faux après chaque réponse.
				</p>
			</div>
			<div class="features-grid">
				{features.map((f, i) => (
					<div class="feature-card" style={`--delay: ${i * 0.1}s`}>
						<div class="feature-icon" set:html={f.icon} />
						<h3 class="feature-title">{f.title}</h3>
						<p class="feature-desc">{f.desc}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- EXAMPLE CARD -->
	<section class="example-section" id="exemple">
		<div class="container">
			<div class="example-layout">
				<div class="example-info">
					<span class="section-tag">Aperçu</span>
					<h2 class="section-title">Une question, c'est<br />comme ça.</h2>
					<p class="section-body">
						Une situation en français, quatre expressions néerlandaises, une seule bonne réponse.
						Après ta réponse, tu reçois le <strong>sens</strong> et le <strong>piège</strong> de la fiche.
						L'expression ratée redevient prioritaire à la session suivante.
					</p>
				</div>

				<div class="example-card-wrapper">
					<div class="expression-card">
						<div class="card-header">
							<span class="card-number">1 / 5</span>
							<span class="card-level">QCM</span>
						</div>
						<div class="card-situation">
							<div class="situation-label">Situation</div>
							<p class="situation-text">
								Tu appelles un collègue et, sans dire bonjour, tu poses tout de suite la question gênante.
								
							</p>
						</div>
						<div class="card-question">
							Quelle expression néerlandaise correspond à cette situation ?
						</div>
						<div class="card-options">
							<button class="option">
								<span class="option-letter">A</span>
								<span>Geen blad voor de mond nemen</span>
							</button>
							<button class="option correct">
								<span class="option-letter">B</span>
								<span>Met de deur in huis vallen</span>
								<span class="option-check">✓</span>
							</button>
							<button class="option">
								<span class="option-letter">C</span>
								<span>De kat uit de boom kijken</span>
							</button>
							<button class="option">
								<span class="option-letter">D</span>
								<span>Iets onder de knie hebben</span>
							</button>
						</div>
						<div class="card-explanation">
							<div class="explanation-title">💡 Explication</div>
							<p>
								<strong>Met de deur in huis vallen</strong> (litt. « tomber dans la maison avec la porte »)
								signifie « <strong>aller droit au but</strong>, sans préambule ».
								Piège : ce n'est pas « débarquer chez quelqu'un ».
							</p>
							<div class="explanation-tags">
								<span class="tag">Oral</span>
								<span class="tag">Un peu brusque</span>
							</div>
						</div>
					</div>
					<div class="card-shadow"></div>
				</div>
			</div>
		</div>
	</section>

	<!-- QUOTE / TRUST -->
	<section class="quote-section">
		<div class="container">
			<div class="quote-card">
				<div class="quote-icon">"</div>
				<blockquote>
					Parce que <em>« appeltje-eitje »</em>, ce n'est pas vraiment
					une recette de cuisine.
				</blockquote>
				<div class="quote-emoji">🍎🥚 😉</div>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="cta-section" id="start">
		<div class="container">
			<div class="cta-box">
				<div class="cta-bg">
					<div class="cta-stripe red"></div>
					<div class="cta-stripe white"></div>
					<div class="cta-stripe blue"></div>
				</div>
				<div class="cta-content">
					<h2 class="cta-title">
						Une session, 5 questions.<br />
						Le sens d'abord,
						<span class="accent">l'expression ensuite.</span>
					</h2>
					<p class="cta-subtitle">
						Pas de compte, pas d'email. Ta progression reste dans ce navigateur.
					</p>
					<a href="/jeux" class="btn btn-primary btn-large">
						<span>Essayer une question</span>
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- FOOTER -->
	<footer class="site-footer">
		<div class="container">
			<div class="footer-main">
				<a href="/" class="footer-logo">
					<span class="logo-flag">🇳🇱</span>
					<span class="logo-text">Makkie</span>
				</a>
				<p class="footer-tagline">Le néerlandais, sans prise de tête.</p>
			</div>
			<div class="footer-bottom">
				<p>© {new Date().getFullYear()} Makkie. Fabriqué avec amour pour les francophones.</p>
			</div>
		</div>
	</footer>
</Layout>

<style>
	/* ==========================================================
	   UTILITIES
	========================================================== */
	.container {
		width: 100%;
		max-width: 1140px;
		margin: 0 auto;
		padding: 0 24px;
	}

	/* ==========================================================
	   HEADER
	========================================================== */
	.site-header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		backdrop-filter: blur(12px);
		background: rgba(253, 251, 248, 0.85);
		border-bottom: 1px solid var(--color-border);
		transition: box-shadow 0.3s ease;
	}

	.header-inner {
		max-width: 1140px;
		margin: 0 auto;
		padding: 0 24px;
		height: 64px;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.logo {
		display: flex;
		align-items: center;
		gap: 8px;
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 1.35rem;
		color: var(--color-text);
	}

	.logo-flag {
		font-size: 1.5rem;
		line-height: 1;
	}

	.logo-text {
		letter-spacing: -0.02em;
	}

	.header-nav {
		display: none;
		align-items: center;
		gap: 28px;
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--color-text-secondary);
	}

	.header-nav a {
		transition: color 0.2s ease;
	}

	.header-nav a:hover {
		color: var(--color-primary);
	}

	.header-cta {
		padding: 8px 18px;
		background: var(--color-text);
		color: #fff;
		border-radius: 100px;
		font-size: 0.85rem;
		font-weight: 600;
		transition: background 0.2s ease, transform 0.2s ease;
	}

	.header-cta:hover {
		background: var(--color-primary);
		transform: translateY(-1px);
	}

	/* ==========================================================
	   HERO
	========================================================== */
	.hero {
		position: relative;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 120px 24px 80px;
		overflow: hidden;
		background: var(--color-bg);
	}

	.hero-bg {
		position: absolute;
		inset: 0;
		z-index: 0;
		opacity: 0.04;
		pointer-events: none;
	}

	.hero-bg .stripe {
		position: absolute;
		left: 0;
		right: 0;
		height: 33.333%;
	}

	.hero-bg .stripe.red { top: 0; background: #AE1C28; }
	.hero-bg .stripe.white { top: 33.333%; background: #FFFFFF; }
	.hero-bg .stripe.blue { top: 66.666%; background: #21468B; }

	.hero-content {
		position: relative;
		z-index: 1;
		text-align: center;
		max-width: 720px;
		animation: fadeInUp 0.8s ease both;
	}

	.hero-badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 6px 16px;
		background: var(--color-primary-light);
		color: var(--color-primary-dark);
		border-radius: 100px;
		font-size: 0.85rem;
		font-weight: 600;
		margin-bottom: 28px;
	}

	.badge-dot {
		width: 8px;
		height: 8px;
		background: var(--color-primary);
		border-radius: 50%;
		animation: pulse 2s infinite;
	}

	@keyframes pulse {
		0%, 100% { opacity: 1; }
		50% { opacity: 0.4; }
	}

	.hero-title {
		font-family: var(--font-heading);
		font-size: clamp(2.8rem, 7vw, 4.5rem);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -0.03em;
		color: var(--color-text);
		margin-bottom: 24px;
	}

	.hero-title .accent {
		color: var(--color-primary);
	}

	.hero-subtitle {
		font-size: clamp(1.05rem, 2.2vw, 1.25rem);
		color: var(--color-text-secondary);
		line-height: 1.7;
		max-width: 560px;
		margin: 0 auto 36px;
	}

	.hero-subtitle strong {
		color: var(--color-text);
		font-weight: 600;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		justify-content: center;
		margin-bottom: 56px;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 14px 28px;
		border-radius: 100px;
		font-weight: 600;
		font-size: 0.95rem;
		transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
		position: relative;
		overflow: hidden;
	}

	.btn-primary {
		background: var(--color-primary);
		color: #fff;
		box-shadow: var(--shadow-primary);
	}

	.btn-primary:hover {
		background: var(--color-primary-dark);
		transform: translateY(-2px);
		box-shadow: 0 12px 32px rgba(232, 97, 0, 0.35);
	}

	.btn-primary svg {
		transition: transform 0.25s ease;
	}

	.btn-primary:hover svg {
		transform: translateX(3px);
	}

	.btn-ghost {
		background: transparent;
		color: var(--color-text);
		border: 1.5px solid var(--color-border);
	}

	.btn-ghost:hover {
		border-color: var(--color-text);
		background: rgba(15, 15, 27, 0.03);
	}

	.btn-large {
		padding: 16px 32px;
		font-size: 1rem;
	}

	.hero-stats {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 20px;
		flex-wrap: wrap;
	}

	.stat {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 4px;
	}

	.stat-number {
		font-family: var(--font-heading);
		font-size: 1.4rem;
		font-weight: 700;
		color: var(--color-text);
	}

	.stat-label {
		font-size: 0.8rem;
		color: var(--color-text-muted);
		font-weight: 500;
	}

	.stat-divider {
		width: 1px;
		height: 36px;
		background: var(--color-border);
	}

	.hero-scroll {
		position: absolute;
		bottom: 28px;
		left: 50%;
		transform: translateX(-50%);
		z-index: 1;
	}

	.scroll-mouse {
		width: 22px;
		height: 34px;
		border: 2px solid var(--color-border);
		border-radius: 12px;
		display: flex;
		justify-content: center;
		padding-top: 6px;
	}

	.scroll-wheel {
		width: 4px;
		height: 6px;
		background: var(--color-text-muted);
		border-radius: 2px;
		animation: scrollWheel 2s infinite;
	}

	@keyframes scrollWheel {
		0% { opacity: 1; transform: translateY(0); }
		100% { opacity: 0; transform: translateY(10px); }
	}

	/* ==========================================================
	   PROBLEM SECTION
	========================================================== */
	.problem-section {
		padding: 100px 0;
		background: var(--color-bg-warm);
	}

	.problem-layout {
		display: grid;
		grid-template-columns: 1fr;
		gap: 48px;
		align-items: center;
	}

	.section-tag {
		display: inline-block;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-primary);
		margin-bottom: 14px;
	}

	.section-title {
		font-family: var(--font-heading);
		font-size: clamp(1.9rem, 4.5vw, 2.8rem);
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: -0.02em;
		color: var(--color-text);
		margin-bottom: 20px;
	}

	.section-body {
		font-size: 1.05rem;
		color: var(--color-text-secondary);
		line-height: 1.7;
		max-width: 480px;
	}

	.section-body strong {
		color: var(--color-text);
		font-weight: 600;
	}

	.problem-points {
		margin-top: 32px;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.problem-point {
		display: flex;
		align-items: flex-start;
		gap: 12px;
		font-size: 0.95rem;
		color: var(--color-text-secondary);
	}

	.problem-point-icon {
		flex-shrink: 0;
		width: 28px;
		height: 28px;
		background: var(--color-primary-light);
		color: var(--color-primary);
		border-radius: var(--radius-sm);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.problem-card {
		background: var(--color-surface);
		border-radius: var(--radius);
		padding: 32px;
		box-shadow: var(--shadow-lg);
		border: 1px solid var(--color-border);
		position: relative;
	}

	.card-badge {
		display: inline-block;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		padding: 4px 12px;
		background: #FEE2E2;
		color: #DC2626;
		border-radius: 100px;
		margin-bottom: 20px;
	}

	.fake-expression {
		display: flex;
		flex-direction: column;
		gap: 8px;
		margin-bottom: 20px;
	}

	.fake-dutch {
		font-family: var(--font-heading);
		font-size: 1.3rem;
		font-weight: 600;
		color: var(--color-text);
	}

	.fake-literal {
		font-size: 1rem;
		color: var(--color-text-muted);
		font-style: italic;
